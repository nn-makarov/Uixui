DATABASE_URL="postgresql://example_user:example_password@127.0.0.1:5432/example_db"

# Placeholder values only. Replace them with local-only values.
POSTGRES_USER="example_user"
POSTGRES_PASSWORD="example_password"
POSTGRES_DB="example_db"
POSTGRES_HOST_PORT="5432"

AUTH_SECRET="replace-with-at-least-32-random-characters"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Optional production HTTPS setting. Leave false for local HTTP.
ENABLE_HSTS="false"

# Required only when creating a new bootstrap OWNER. Never commit real values.
BOOTSTRAP_ADMIN_EMAIL="operator@example.invalid"
BOOTSTRAP_ADMIN_PASSWORD="replace-with-a-strong-temporary-password"

STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./.storage"

CRON_SECRET="replace-with-at-least-32-random-characters"
PUBLIC_TOKEN_SECRET="replace-with-at-least-32-random-characters"

TEMP_UPLOAD_TTL_HOURS="24"
IDEMPOTENCY_TTL_HOURS="48"

TRUST_PROXY="false"
TRUSTED_PROXIES=""
